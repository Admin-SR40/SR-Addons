{
  "schemaVersion": 1,
  "id": "sraddons",
  "version": "${version}",
  "name": "SR-Addons",
  "description": "All-in-one client mod · 多合一综合客户端 Mod",
  "authors": ["Admin_SR40"],
  "license": "MIT",
  "icon": "assets/sraddons/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.sraddons.SRAddonsMod"
    ],
    "modmenu": [
      "com.sraddons.compatibility.modmenu.ModMenuIntegration"
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github": "https://github.com/Admin-SR40/SR-Addons"
      }
    }
  },
  "mixins": [
    {
      "config": "sraddons.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": ">=26.2",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.14.0",
    "yet_another_config_lib_v3": ">=3.9.0"
  }
}
